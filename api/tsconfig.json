{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "typeRoots": ["../artifacts/api-server/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../artifacts/api-server/src/**/*.ts"]
}
